PORT=4000
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Human Presidents required to start (2–8). Test delegates do not count.
MIN_PLAYERS=2
# Production requires DATABASE_URL and a single backend replica.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/republic
# Without DATABASE_URL, development uses persistent embedded PostgreSQL (.data/).
